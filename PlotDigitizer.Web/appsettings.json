{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"Microsoft.Hosting.Lifetime": "Information"
		}
	},
	"AllowedHosts": "*",
	"DigitizerSession": {
		"IdleTimeout": "00:30:00",
		"MaxConcurrentSessions": 50,
		"MaxUploadBytes": 20971520
	},
	"OCR": {
		"Numerical": {
			"DataPath": "OCR",
			"Language": "eng",
			"WhiteList": "E.-0123456789"
		},
		"Text": {
			"DataPath": "OCR",
			"Language": "eng",
			"WhiteList": ""
		}
	}
}
