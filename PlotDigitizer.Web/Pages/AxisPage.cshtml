@page "{handler?}"
@model PlotDigitizer.Web.Pages.AxisPageModel
@{
	ViewData["Title"] = "Axis";
}
@section Scripts {
	<script src="~/lib/interactjs/interact.min.js"></script>
	<script src="~/js/selectionBox.js" asp-append-version="true"></script>
	<script src="~/js/axisPage.js" asp-append-version="true"></script>
}

<h1 class="h3">Mark the plot area</h1>
<p class="text-muted">
	Drag and resize the red box so it covers exactly the area bounded by the axes. Everything
	outside it is discarded.
</p>

<div asp-validation-summary="ModelOnly" class="alert alert-warning" role="alert"></div>

<div id="view">
	<partial name="_AxisPageView" model="Model.Model" />
</div>

<form method="post" class="mt-3" id="axis-form">
	<input type="hidden" name="x" id="axis-x" />
	<input type="hidden" name="y" id="axis-y" />
	<input type="hidden" name="width" id="axis-width" />
	<input type="hidden" name="height" id="axis-height" />

	<div class="d-flex gap-2 align-items-center">
		<a class="btn btn-outline-secondary" asp-page="@Model.PreviousStep.PageName">Back</a>
		<button class="btn btn-outline-primary" type="button" id="detect-axis">Detect automatically</button>
		<button class="btn btn-primary" type="submit">Next: @Model.NextStep.Title</button>
		<span class="editor-status ms-2" id="axis-readout"></span>
	</div>
</form>
