@model PlotDigitizer.Web.Models.Model
@{
	var image = Model.InputImage;
	var axis = Model.Setting.AxisLocation;
}
<div class="image-canvas" id="axis-canvas"
	 style="width: @(Model.DisplayWidth)px;"
	 data-image-width="@image.Width"
	 data-image-height="@image.Height">
	<img src="@Model.InputImageUrl" alt="Plot" />
	<div class="selection-box" id="axis-box" data-name="axis"
		 data-x="@axis.Left.ToString(System.Globalization.CultureInfo.InvariantCulture)"
		 data-y="@axis.Top.ToString(System.Globalization.CultureInfo.InvariantCulture)"
		 data-width="@axis.Width.ToString(System.Globalization.CultureInfo.InvariantCulture)"
		 data-height="@axis.Height.ToString(System.Globalization.CultureInfo.InvariantCulture)">
		<span class="selection-caption">Plot area</span>
	</div>
</div>
