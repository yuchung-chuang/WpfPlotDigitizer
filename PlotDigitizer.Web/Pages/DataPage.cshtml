@page "{handler?}"
@model PlotDigitizer.Web.Pages.DataPageModel
@using PlotDigitizer.Core
@{
	ViewData["Title"] = "Data";
}
@section Scripts {
	<script src="~/js/dataPage.js" asp-append-version="true"></script>
}

<h1 class="h3">Digitized data</h1>

@if (!Model.IsAxisLimitSet)
{
	<div class="alert alert-warning" role="alert">
		The axis range has not been set, so the values below are not calibrated.
		<a asp-page="/RangePage">Set the range</a>.
	</div>
}

<div class="btn-toolbar flex-wrap gap-2 mb-3" role="toolbar">
	<div class="btn-group" role="group" aria-label="Data type">
		<input type="radio" class="btn-check" name="data-type" id="type-continuous"
			   value="@((int)DataType.Continuous)" checked="@(Model.Setting.DataType == DataType.Continuous)" />
		<label class="btn btn-outline-secondary btn-sm" for="type-continuous">Continuous</label>

		<input type="radio" class="btn-check" name="data-type" id="type-discrete"
			   value="@((int)DataType.Discrete)" checked="@(Model.Setting.DataType == DataType.Discrete)" />
		<label class="btn btn-outline-secondary btn-sm" for="type-discrete">Discrete</label>
	</div>

	<div class="btn-group" role="group" aria-label="Export">
		<a class="btn btn-primary btn-sm" href="?handler=Export&amp;format=csv">Export CSV</a>
		<a class="btn btn-outline-primary btn-sm" href="?handler=Export&amp;format=txt">Export TXT</a>
	</div>

	<span class="editor-status align-self-center" id="data-message"></span>
</div>

<div id="view">
	<partial name="_DataPageView" model="Model" />
</div>

<div class="mt-3">
	<a class="btn btn-outline-secondary" asp-page="@Model.PreviousStep.PageName">Back</a>
</div>
