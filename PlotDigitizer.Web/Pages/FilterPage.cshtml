@page "{handler?}"
@model PlotDigitizer.Web.Pages.FilterPageModel
@{
	ViewData["Title"] = "Filter";
	var min = Model.Setting.FilterMin;
	var max = Model.Setting.FilterMax;
}
@section Styles {
	<link rel="stylesheet" href="~/css/filterPage.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/nouislider/nouislider.min.js"></script>
	<script src="~/js/filterPage.js" asp-append-version="true"></script>
}

<h1 class="h3">Isolate the data series</h1>
<p class="text-muted">
	Narrow each colour channel until only the curve or the markers remain. The checkerboard shows
	the pixels that have been removed.
</p>

<div class="row g-4">
	<div class="col-xl-7">
		<div id="view">
			<partial name="_FilterPageView" model="Model.Model" />
		</div>
	</div>

	<div class="col-xl-5">
		<div class="mb-4">
			<label class="form-label" for="filterR">Red</label>
			<div id="filterR" data-min="@min.Red" data-max="@max.Red"></div>
		</div>
		<div class="mb-4">
			<label class="form-label" for="filterG">Green</label>
			<div id="filterG" data-min="@min.Green" data-max="@max.Green"></div>
		</div>
		<div class="mb-4">
			<label class="form-label" for="filterB">Blue</label>
			<div id="filterB" data-min="@min.Blue" data-max="@max.Blue"></div>
		</div>
		<p class="editor-status" id="filter-status"></p>
	</div>
</div>

<form method="post" class="d-flex gap-2 mt-3">
	<a class="btn btn-outline-secondary" asp-page="@Model.PreviousStep.PageName">Back</a>
	<button class="btn btn-primary" type="submit">Next: @Model.NextStep.Title</button>
</form>
