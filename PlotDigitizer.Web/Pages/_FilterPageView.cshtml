@model PlotDigitizer.Web.Models.Model
@{
	var image = Model.FilteredImage;
	var url = Model.FilteredImageUrl;
}
@if (image is null || url is null)
{
	<p class="text-muted">Nothing to preview yet.</p>
}
else
{
	<div class="image-canvas"
		 style="width: @(Model.DisplayWidth)px;"
		 data-image-width="@image.Width"
		 data-image-height="@image.Height">
		<img src="@url" alt="Filtered plot area" />
	</div>
}
