@page "/load"
@using System.Diagnostics
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Load Image</PageTitle>

<h1>Load Image</h1>

<p>Upload the image you want to digitize.</p>

<InputFile @ref="inputFile" OnChange="PreviewImage"/>
<br />
<br />
@if (!string.IsNullOrEmpty(imageUrl)) {
    <img src="@imageUrl" alt="Uploaded Image" style="max-width:400px; max-height:300px;" />
}

@code {
    private string? imageUrl;
    private InputFile? inputFile;

    private async Task PreviewImage(InputFileChangeEventArgs e)
    {
        // Generate an Object URL for preview
        imageUrl = await JSRuntime.InvokeAsync<string>("createObjectURL", inputFile!.Element);

        // Load the image into memory/file?
        
    }
}

