<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>PlotDigitizer.Blazor</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Must stay on the same Emgu version as PlotDigitizer.Core, otherwise the native
		     runtime package does not match the managed assembly Core was built against. -->
		<PackageReference Include="Emgu.CV.runtime.windows" Version="4.9.0.5494" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PlotDigitizer.Core\PlotDigitizer.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\.editorconfig" Link=".editorconfig" />
	</ItemGroup>

</Project>
